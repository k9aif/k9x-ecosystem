# k9x_dashboard — environment config
# Copy to .env (gitignored, never commit real values).

# Read-only connection to HIL's own Postgres (k9hil schema) -- same
# instance HIL itself uses. See backend/database.py for why this is a
# direct DB read rather than calling HIL's own (authenticated) API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=k9x
HIL_SCHEMA=k9hil

# Real nvidia-smi-backed telemetry server already running on the PowerAI
# host (same one k9chat proxies) -- default assumes this app is running
# containerized (host.containers.internal resolves inside Podman/Docker's
# network namespace, same pattern k9x_studio uses for its Ollama URL).
# Override with a real LAN IP if running main.py bare (local dev only).
K9X_GPU_TELEMETRY_URL=http://host.containers.internal:5000/gpu
